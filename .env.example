# === CẤU HÌNH API KEYS MẪU ===
# Lấy Google Gemini API Key miễn phí tại: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Lấy Groq API Key miễn phí (dự phòng) tại: https://console.groq.com/keys
